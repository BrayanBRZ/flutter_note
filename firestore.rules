rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/backups/current {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['snapshot', 'savedAt'])
        && request.resource.data.snapshot is string
        && request.resource.data.snapshot.size() <= 921600
        && request.resource.data.savedAt is timestamp;
    }
  }
}
